# Supabase Public API configuration (safe to expose to client-side browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Secret Key
# WARNING: CRITICAL SECURITY CONSTRAINT
# The service-role key bypasses Row-Level Security (RLS) entirely.
# NEVER prefix this key with NEXT_PUBLIC_ or expose it to client-side bundles.
# Only use this key in secure server environments (e.g., API route handlers, server actions).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
